# ============================================
# MAXMUXSIX - .gitignore
# ============================================

# Sensitive config & credentials (NEVER commit)
email_config.json
*.env
.env
.env.*
config.local.*
secrets.*
credentials.*
*.key
*.pem
*.p12

# Python server & cache
email_server.py
__pycache__/
*.py[cod]
*.pyo
*.pyd

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Temp / scratch files
temp_*.js
temp_*.py
temp_*.json
*.tmp
*.bak

# Node (if added later)
node_modules/
npm-debug.log*

# AI Agent Skills (local machine only)
.agents/
.agent/
_agents/
_agent/

